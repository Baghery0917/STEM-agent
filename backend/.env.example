# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/stem_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/stem_db

# pgvector
PGVECTOR_DIMENSION=1024

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# CORS — 逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI 兼容)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-flash
LLM_VISION_MODEL=qwen3.6-flash
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSION=1024

# 情绪识别服务（未配置则跳过，不会中断主流程）
EMOTION_BASE_URL=
EMOTION_API_KEY=

# 教学策略服务（未配置则用 LLM fallback）
TEACHING_STRATEGY_BASE_URL=
TEACHING_STRATEGY_API_KEY=

# 教学参考题相似度阈值：检索出的最相似题 >= 该值才作为参考注入 LLM
TEACHING_REFERENCE_SIMILARITY_THRESHOLD=0.8
