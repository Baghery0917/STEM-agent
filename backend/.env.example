# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/stem_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/stem_db

# pgvector
PGVECTOR_DIMENSION=1024

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# CORS — 逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI 兼容)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-flash
LLM_VISION_MODEL=qwen3.6-flash
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSION=1024

# 面部情绪识别服务（HTTP，POST {EMOTION_BASE_URL}/recognize；未配置则只用文本情绪）
EMOTION_BASE_URL=
EMOTION_API_KEY=
EMOTION_TIMEOUT_SECONDS=3

# 教学策略服务（MCP Streamable HTTP，tool get_teaching_strategy；未配置或失败则用 LLM fallback）
TEACHING_STRATEGY_MCP_URL=
TEACHING_STRATEGY_API_KEY=
TEACHING_STRATEGY_TIMEOUT_SECONDS=5

# 评价处服务（MCP Streamable HTTP，tool get_student_evaluation；自行读库，后端只传 student_id）
EVALUATION_MCP_URL=
EVALUATION_API_KEY=
EVALUATION_TIMEOUT_SECONDS=15

# 管理台登录口令（留空则管理台不可登录；生产必填）
ADMIN_PASSWORD=admin

# 情绪加权与回流
EMOTION_FACIAL_WEIGHT=0.6
EMOTION_HISTORY_ALPHA=0.3

# 教学会话空闲自动结束
TEACHING_IDLE_TIMEOUT_MINUTES=30
TEACHING_IDLE_SWEEP_INTERVAL_SECONDS=300

# 教学参考题相似度阈值：检索出的最相似题 >= 该值才作为参考注入 LLM
TEACHING_REFERENCE_SIMILARITY_THRESHOLD=0.8
